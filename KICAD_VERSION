# Minimum KiCad release used for every checked-in KiCad file, and the file-format
# tokens that release writes. CI compares these against the files.
# KiCad files record only "10.0" (no patch level), so the patch minimum is
# enforced by pinning the CI image to KICAD_MIN_VERSION.
KICAD_MIN_VERSION=10.0.6
KICAD_GENERATOR_VERSION=10.0
KICAD_SCH_FORMAT=20260306
KICAD_PCB_FORMAT=20260206
KICAD_PRO_META_VERSION=3
